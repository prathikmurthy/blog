---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import FormattedDate from "../components/FormattedDate.astro";

// const posts = (await getCollection("blog")).sort(
//   (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
// );

let posts = (await getCollection("blog")).filter((post) => !post.data.draft);
let map: Record<number, typeof posts> = {};

posts.forEach((post) => {
  const date = new Date(post.data.pubDate);
  const year = date.getFullYear();
  if (!map[year]) {
    map[year] = [];
  }
  map[year].push(post);
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <style>
      .post-list {
        display: grid;
        grid-template-columns: 6em 1fr; 
        gap: 0.5em;
        align-items: baseline;
      }
      .post-date {
        color: var(--color-text-muted);
        white-space: nowrap;
      }
      .post-year {
        color: var(--color-text-faint);
        font-size: 0.75em;
        margin-top: 1em;
      }
      .post-title {
        margin: 0;
        font-size: 1rem;
        font-weight: normal;
        line-height: 1.5;
      }
      .post-list a {
        color: inherit;
        text-decoration: none;
      }
      .post-list a:hover .post-title {
        color: var(--color-link);
      }

      .post-tags {
        color: var(--color-text-muted);
        font-size: 0.875em;
      }

      .post-info {
        display: flex;
        gap: 1em;
      }


    </style>
    <main>
      <Header />
      <div class="post-list">
        {
          Object.keys(map)
            .sort((a, b) => Number(b) - Number(a))
            .map((year) => (
              <>
                <span class="post-year">{year}</span>
                <span></span>
                {map[Number(year)].map((post) => (
                  <>
                    <span class="post-date">
                      <FormattedDate date={new Date(post.data.pubDate)} />
                    </span>
                    <div class="post-info">
                      <a href={`/blog/${post.id}/`}>
                        <h4 class="post-title">{post.data.title}</h4>
                      </a>
                      <span class="post-tags">
                        {post.data.tags?.map((tag) => `#${tag} `)}
                      </span>
                    </div>
                  </>
                ))}
              </>
            ))
        }
      </div>
    </main>
  </body>
</html>
