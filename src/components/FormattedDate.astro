---
interface Props {
	date: Date;
	showYear?: boolean;
}

const { date, showYear = false } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: showYear ? 'numeric' : undefined,
			month: 'short',
			day: '2-digit',
		}).toLowerCase()
	}
</time>
